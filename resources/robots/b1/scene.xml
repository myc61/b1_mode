<mujoco model="b1_scene">
    <!-- 机器人模型 -->
    <include file="urdf/b1.xml"/>

    <!-- 场景地面与光源 -->
    <compiler angle="degree" coordinate="local"/>
    <option timestep="0.002" gravity="0 0 -9.81"/>
    
    <visual>
        <map znear="0.01" zfar="50"/>
        <quality shadowsize="2048"/>
    </visual>

    <worldbody>
        <!-- 地面 -->
        <geom name="floor" type="plane" size="10 10 0.1" rgba="0.9 0.9 0.9 1"/>

        <!-- 默认摄像机 -->
        <camera name="track" mode="trackcom" pos="0 -3 1.5" xyaxes="1 0 0 0 0 1"/>

        <!-- 光源 -->
        <light name="top" pos="0 0 3" dir="0 0 -1" diffuse="1 1 1" specular="0.2 0.2 0.2"/>
    </worldbody>
</mujoco>

